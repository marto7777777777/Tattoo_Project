{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<sql-host>;Database=<db>;User Id=<user>;Password=<secret>;TrustServerCertificate=False;"
  },
  "AllowedHosts": "api.example.com",
  "Jwt": {
    "Key": "<minimum-32-character-random-secret>",
    "Issuer": "InkRoute",
    "Audience": "InkRouteUsers",
    "ExpiresInMinutes": 1440
  },
  "EmailSettings": {
    "SmtpHost": "<smtp-host>",
    "SmtpPort": 587,
    "SmtpUsername": "<smtp-user>",
    "SmtpPassword": "<smtp-secret>",
    "SenderEmail": "<sender@example.com>",
    "SenderName": "InkRoute"
  },
  "FrontendUrl": "https://example.com",
  "BackendUrl": "https://api.example.com",
  "Verification": {
    "CodeHashSecret": "<minimum-32-character-random-secret>"
  },
  "OpenAI": {
    "ApiKey": "<secret>",
    "ImageModel": "gpt-image-2",
    "TextModel": "gpt-5-mini",
    "PlannerMaxOutputTokens": 900
  },
  "Stripe": {
    "SecretKey": "<secret>",
    "WebhookSecret": "<secret>",
    "ArtistMonthlyPriceId": "<price-id>",
    "AiProjectPassPriceId": "<one-time-price-id>",
    "CustomerPortalConfigurationId": "<optional>",
    "Currency": "eur",
    "AiProjectPassAmount": 1249
  },
  "Billing": {
    "AllowSandboxEntitlements": false,
    "AccountObfuscationSecret": "<minimum-32-character-random-secret>"
  },
  "GooglePlay": {
    "PackageName": "com.inkroute.app",
    "ArtistSubscriptionProductId": "<product-id>",
    "ArtistBasePlanId": "<base-plan-id>",
    "ArtistTrialOfferId": "<trial-offer-id>",
    "AiProjectPassProductId": "<consumable-product-id>",
    "ServiceAccountJsonPath": "/run/secrets/google-play.json",
    "PubSubAudience": "<expected-audience>",
    "PubSubServiceAccountEmail": "<service-account-email>"
  },
  "Apple": {
    "BundleId": "com.inkroute.app",
    "ArtistSubscriptionProductId": "<subscription-product-id>",
    "AiProjectPassProductId": "<consumable-product-id>",
    "IssuerId": "<issuer-id>",
    "KeyId": "<key-id>",
    "PrivateKeyPath": "/run/secrets/apple-subscriptions.p8",
    "RootCertificatePath": "/run/secrets/apple-root.cer"
  },
  "DataProtection": {
    "KeysPath": "/var/lib/inkroute/dpkeys",
    "CertificatePath": "<optional-absolute-pfx-path>",
    "CertificatePassword": "<optional-secret>"
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "/var/lib/inkroute/media"
  },
  "Proxy": {
    "Enabled": true,
    "ForwardLimit": 1,
    "KnownProxies": [
      "10.0.0.10"
    ]
  },
  "Legal": {
    "TermsVersion": "<current-version>",
    "PrivacyVersion": "<current-version>",
    "TermsUrl": "/legal/terms",
    "PrivacyUrl": "/legal/privacy"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://example.com"
    ]
  },
  "PaymentProviders": {
    "StripeEnabled": true,
    "GooglePlayEnabled": true,
    "AppleEnabled": true
  },
  "Features": {
    "AiEnabled": true
  }
}
