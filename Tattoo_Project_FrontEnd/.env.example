# Local browser development uses https://localhost:7115 when this is omitted.
# Mobile and production builds must use the public HTTPS backend address.
VITE_API_BASE_URL=https://api.inkroute.app

# Canonical public website used by artist share links, including native builds.
VITE_PUBLIC_APP_URL=https://inkroute.app

# Optional landing-page destinations. Empty store URLs fall back to web registration.
VITE_WEB_REGISTER_URL=/register
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# Optional SEO values for /for-artists.
VITE_LANDING_CANONICAL_URL=https://inkroute.app/for-artists
VITE_LANDING_OG_IMAGE_URL=

# Public identifiers only. Leave empty until the consent implementation is tested.
VITE_GTM_CONTAINER_ID=
VITE_GA4_MEASUREMENT_ID=
VITE_META_DATASET_ID=
VITE_BUSINESS_PHONE=
